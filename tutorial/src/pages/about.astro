---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

import '../styles/global.css';

const pageTitle = "About me";

const identity = {
    firstName:  "Shingo",
    country:    "Japan",
    occupation: "Software Planner",
    hobbies: ["Programming", "Traveling", "Cooking"],
};

const skills = ["HTML", "CSS", "JavaScript", "Astro"]

const happy = true;
const finished = false;
const goal = 3;

const skillColor = "crimson";
const fontWaint = "bold";
const textCase = "uppercase";
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{pageTitle}</title>
        <style define:vars={{skillColor}}>
            h1 {
                color: purple;
                font-size: 4rem;
            }
            .skill {
                color: var(--skillColor);
                font-weight: var(--fontWeight);
                text-transform: var(--textCase);
                }
        </style>
	</head>
	<body>
        <Header />
		<h1>{pageTitle}</h1>
        <p>The following is about me:</p>
        <ul>
            <li>First name is {identity.firstName}.</li>
            <li>I live in {identity.country}.</li>
            <li>My occupation is {identity.occupation}.</li>
            <li>My hobbies are {identity.hobbies[0]} and {identity.hobbies[1]}.</li>
        </ul>
        <p>I have the following skills: </p>
        <ul>
            {skills.map((skill) => <li class="skill">{skill}</li>)}
        </ul>
        {happy && <p>I am happy to be learning Astro! Astroを学べて幸せです!</p>}
        {!finished && <p>I finished this tutorial! 個のチュートリアルを終えました!</p>}
        {goal === 3 ? <p>My goal is to finish in 3 days. 3日で終えるのが目標です。</p> : <p>My goal is not 3 days. 3日が目標ではありません。</p>}
        <Footer />
    </body>
</html>